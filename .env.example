# ===== 必填密钥 =====
RMH_TG_BOT_TOKEN=
RMH_TG_CHAT_ID=
RMH_TMDB_API_KEY=
RMH_EMBY_URL=
RMH_EMBY_API_KEY=

# ===== 可选 =====
# RMH_TG_THREAD_ID=
# RMH_TG_API_BASE=          # TG 反向代理
# RMH_TG_PROXY=             # 正向代理 http://host:port
# RMH_TMDB_API_BASE=
# RMH_TMDB_PROXY=
# RMH_TMDB_LANGUAGE=zh-CN
# RMH_EMBY_USER_ID=
# RMH_EMBY_COUNT_AIRED_ONLY=true
# RMH_EMBY_INCLUDE_SPECIALS=false
# RMH_EMBY_VERIFY_TLS=false
# RMH_POLL_INTERVAL=300
# RMH_EMBY_CHECK_INTERVAL=3600
# RMH_AUTO_SUBSCRIBE=false
# RMH_LOG_LEVEL=INFO
# RMH_WEB_PORT=18080
# RMH_WEB_TOKEN=            # Web UI 访问令牌，留空不鉴权
# RMH_DATA_DIR=data

# ===== 4 类通知开关（默认全开，可单独关闭某一类）=====
# RMH_NOTIFY_FEED_NEW=true         # 发现新种
# RMH_NOTIFY_SHOW_NEW=true         # 剧集更新进度
# RMH_NOTIFY_LIBRARY_UPDATE=true   # 媒体库新入库
# RMH_NOTIFY_DONE=true             # 追完/完结
